# Backend (copy to backend/.env)
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=replace-with-a-long-random-string
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5000000
ADMIN_EMAIL=
ADMIN_PASSWORD=
MODEL_DIR=models
AI_PRODUCT_FINDER_ENABLED=true
VISION_MODEL_DIR=models/vision
VISION_DATASET_DIR=vision_dataset
MAX_PRODUCT_IMAGE_BYTES=5000000
# Backend-only outbound webhook. Leave empty to skip N8N.
# Set this in backend/.env (gitignored), never in frontend or as VITE_*.
N8N_WEBHOOK_URL=
