    {
      "parameters": {
        "jsCode": "const checked = $('Check Duplicate').first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.processedEvents || typeof staticData.processedEvents !== 'object') {\n  staticData.processedEvents = {};\n}\nconst eventId = checked.event_id == null ? '' : String(checked.event_id).trim();\nif (eventId && checked.duplicate_status === 'new' && checked.should_send_email) {\n  staticData.processedEvents[eventId] = true;\n}\nreturn [{ json: { ...checked, processed_logged: Boolean(eventId && checked.should_send_email), email_sent: true, action: 'processed' } }];"
      },
