            {
              "id": "is-error",
              "leftValue": "={{ $json.duplicate_status }}",
              "rightValue": "error",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
