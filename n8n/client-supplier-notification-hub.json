{
  "name": "Client Supplier Notification Hub",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "client-supplier-notifications",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-hub",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "client-supplier-notifications"
    },
    {
      "parameters": {
        "jsCode": "const incoming = $json.body && typeof $json.body === 'object' && Object.keys($json.body).length ? $json.body : $json;\nconst raw = { ...incoming };\nconst eventType = String(raw.event_type || raw.event || '').trim();\nconst eventId = raw.event_id == null ? '' : String(raw.event_id).trim();\nconst supplierEvents = new Set(['MATCH_CREATED','CLIENT_REQUEST_SENT','PAYMENT_CONFIRMED','ORDER_RECEIVED','ORDER_COMPLETED']);\nconst clientEvents = new Set(['SUPPLIER_ACCEPTED','SUPPLIER_DECLINED','SHIPMENT_SHIPPED']);\nfunction text(value) {\n  if (value == null) return '';\n  return String(value).trim();\n}\nfunction formatPercent(score) {\n  if (score == null || score === '') return null;\n  const n = Number(score);\n  if (Number.isNaN(n)) return null;\n  const pct = Math.round(n * 10000) / 100;\n  if (Number.isInteger(pct)) return `${pct}%`;\n  return `${pct.toFixed(2).replace(/0+$/, '').replace(/\\.$/, '')}%`;\n}\nlet recipient = text(raw.recipient_email);\nif (!recipient) {\n  if (supplierEvents.has(eventType)) recipient = text(raw.supplier_email);\n  else if (clientEvents.has(eventType)) recipient = text(raw.client_email);\n  else recipient = text(raw.supplier_email) || text(raw.client_email);\n}\nlet matchScorePercent = raw.match_score_percent || formatPercent(raw.match_score);\nlet workflowStatus = 'ok';\nlet workflowError = null;\nif (!eventId) {\n  workflowStatus = 'invalid';\n  workflowError = 'missing_event_id';\n} else if (eventType && eventType !== 'quotation.created' && raw.supplier_id == null && raw.client_id == null) {\n  workflowStatus = 'invalid_party';\n  workflowError = 'invalid_or_missing_supplier_or_client_id';\n} else if (!recipient && eventType !== 'quotation.created') {\n  workflowStatus = 'missing_recipient';\n  workflowError = 'recipient_email_unavailable';\n}\nreturn [{\n  json: {\n    ...raw,\n    event_type: eventType,\n    event_id: eventId,\n    recipient_email: recipient || null,\n    has_recipient: Boolean(recipient),\n    match_score: raw.match_score,\n    match_score_percent: matchScorePercent,\n    workflow_status: workflowStatus,\n    workflow_error: workflowError,\n  },\n}];"
      },
      "id": "normalize-event",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "try {\n  const src = { ...$json };\n  const eventId = src.event_id == null ? '' : String(src.event_id).trim();\n  const staticData = $getWorkflowStaticData('global');\n  if (!staticData.processedEvents || typeof staticData.processedEvents !== 'object') {\n    staticData.processedEvents = {};\n  }\n  if (!eventId) {\n    return [{ json: { ...src, duplicate_status: 'invalid', duplicate_reason: 'missing_event_id', is_duplicate: false, should_send_email: false } }];\n  }\n  if (src.workflow_status === 'invalid_party') {\n    return [{ json: { ...src, duplicate_status: 'invalid', duplicate_reason: src.workflow_error || 'invalid_party', is_duplicate: false, should_send_email: false } }];\n  }\n  if (staticData.processedEvents[eventId]) {\n    return [{ json: { ...src, duplicate_status: 'duplicate', duplicate_reason: 'event_id_already_processed', is_duplicate: true, should_send_email: false } }];\n  }\n  const shouldSend = Boolean(src.has_recipient) && src.workflow_status !== 'missing_recipient';\n  return [{ json: { ...src, duplicate_status: 'new', duplicate_reason: null, is_duplicate: false, should_send_email: shouldSend } }];\n} catch (error) {\n  return [{ json: { ...$json, duplicate_status: 'error', duplicate_reason: 'database_unavailable', lookup_error: error.message, is_duplicate: false, should_send_email: false } }];\n}"
      },
      "id": "check-duplicate",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
